{
  "name": "teamengage",
  "version": "0.9.0",
  "description": "One human, many local LLM agents, planning and executing together on shared plans.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "te": "./dist/cli/main.js",
    "teamengage": "./dist/cli/main.js",
    "teamengaged": "./dist/daemon/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && npm run build:web",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build:web": "esbuild web/app.js --bundle --format=esm --splitting --outdir=web/dist --minify",
    "ui": "node dist/cli/main.js ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "bootstrap": "^5.3.8",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.0",
    "htm": "3.1",
    "mermaid": "^11.17.2",
    "preact": "10.26",
    "yaml": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "web/dist",
    "web/index.html",
    "web/favicon.svg",
    "web/logo.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Mohammad Hefny (HefnySco)"
}
