{
  "name": "teamengage",
  "version": "0.1.0",
  "description": "One human, many local LLM agents, planning and executing together on shared plans.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "te": "./dist/cli/main.js",
    "teamengage": "./dist/cli/main.js",
    "teamengaged": "./dist/daemon/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.0",
    "yaml": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
